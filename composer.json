{
    "name": "volcy/translator-core",
    "description": "Framework-agnostic Blade string extraction and JSON-based translation catalog.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "translation",
        "i18n",
        "blade",
        "localization"
    ],
    "authors": [
        {
            "name": "Yowensly Volcy",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Volcy\\Translator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Volcy\\Translator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}